# IP-адреса серверов. Формат: VAR=1.2.3.4
# В Git Bash НЕ используйте угловые скобки <IP> — символ < ломает source.
# Замените REPLACE_ME на реальные публичные IP после заказа VPS.

USER=sky

DEVTOOLS_IP=78.140.240.30 #201.51.27.38
K3S_SERVER_IP=REPLACE_ME
K3S_WORKER_1_IP=REPLACE_ME
K3S_WORKER_2_IP=REPLACE_ME
STORAGE_1_IP=REPLACE_ME
STORAGE_2_IP=REPLACE_ME

# Внешний IP Traefik (на схеме может совпадать с worker-1 — подставьте свой)
TRAEFIK_ENTRY_IP=REPLACE_ME

# Алиасы имён из гайда (если в командах K8S_MASTER_IP / TRAEFIK_1_IP):
K8S_MASTER_IP=${K3S_SERVER_IP}
TRAEFIK_1_IP=${TRAEFIK_ENTRY_IP}
