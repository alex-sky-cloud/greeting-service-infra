# IP-адреса серверов. Формат: VAR=1.2.3.4
# В Git Bash НЕ используйте угловые скобки <IP> — символ < ломает source.
# Файл в .gitignore — не коммитить.

USER=sky

# Каждый сервер — один блок: IP, пользователь, пароль.
# Фаза 0 prepare-server читает *_SSH_USER и *_SSH_PASSWORD. Не коммитить.
SSH_BOOTSTRAP_DEFAULT_USER=root

# k8s-master
K3S_SERVER_IP=145.79.177.146
K3S_SERVER_SSH_USER=root
K3S_SERVER_SSH_PASSWORD='Ma+ytkbCh5v4Ud'
K8S_MASTER_IP=${K3S_SERVER_IP}

