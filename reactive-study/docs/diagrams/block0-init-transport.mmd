flowchart TB
    subgraph P0["⏳ До bind — HTTP-порт ещё закрыт"]
        direction TB
        MAIN["SpringApplication.run()"]
        CTX["Контекст Spring: Flyway, R2DBC, beans"]
        MAIN --> CTX
    end

    subgraph P1["🟢 Шаг 1 — Spring Boot собирает сервер"]
        direction TB
        FACTORY["NettyReactiveWebServerFactory\n.getWebServer()"]
        HTTP_SRV["HttpServer\nпорт 8083, настройки"]
        NETTY_WS["NettyWebServer\nобёртка Spring"]
        FACTORY --> HTTP_SRV --> NETTY_WS
    end

    subgraph P2["🔵 Шаг 2 — Старт bind"]
        direction TB
        START["NettyWebServer.start()\nstartHttpServer()"]
        BINDNOW["HttpServer.bindNow()\nMono.block на потоке server"]
        START --> BINDNOW
    end

    subgraph P3["🟣 Шаг 3 — Reactor Netty: TransportConnector"]
        direction TB
        ST_BIND["ServerTransport.bind()"]
        TC_BIND["TransportConnector.bind()"]
        ST_BIND --> TC_BIND
    end

    subgraph P4["🟠 Шаг 4 — LoopResources создаёт пулы потоков"]
        direction LR
        subgraph BOSS["👔 Acceptor / Boss"]
            ONSEL["onServerSelect()\nDefaultLoopResources"]
            BOSS_GRP["EventLoopGroup acceptor\nпоток reactor-http-nio-*"]
            ONSEL --> BOSS_GRP
        end
        subgraph WORK["👷 Worker"]
            ONSRV["onServer()\nDefaultLoopResources"]
            WORK_GRP["EventLoopGroup worker\n≈ CPU потоков, мин. 4"]
            ONSRV --> WORK_GRP
        end
    end

    subgraph P5["🔴 Шаг 5 — Netty: server Channel + порт"]
        direction TB
        INIT["doInitAndRegister()\nServerSocketChannel"]
        CHAN["Server Channel\nобёртка listening socket"]
        REG["register на acceptor EventLoop"]
        PORT["bind localhost:8083"]
        READ["doBeginRead()\nOP_ACCEPT на Selector"]
        INIT --> CHAN --> REG --> PORT --> READ
    end

    subgraph P6["✅ После init — готово к curl"]
        direction TB
        LOG["Лог: Netty started on port 8083\nStarted ReactiveStudyApplication"]
        READY["Listening socket ждёт TCP\nClient Channel — ещё нет"]
        LOG --> READY
    end

    P0 -->|"NettyWebServer.start()"| P1
    P1 --> P2
    P2 --> P3
    P3 --> P4
    P4 --> P5
    P5 --> P6

